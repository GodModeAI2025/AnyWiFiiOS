          "stringUnit": {
            "state": "translated",
            "value": "Notifications are off. Without them you won't know when a value is missing."
          }
        }
      }
    },
    "Meldet dich an, sobald das Gerät ein WLAN mit aktivem Profil betritt. Nur Netze aus deinen Profilen werden beansprucht. Ohne diese Funktion bleibt der Manuelle Modus (App öffnen, Kurzbefehl, Control Center).": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldet dich an, sobald das Gerät ein WLAN mit aktivem Profil betritt. Nur Netze aus deinen Profilen werden beansprucht. Ohne diese Funktion bleibt der Manuelle Modus (App öffnen, Kurzbefehl, Control Center)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signs you in as soon as the device joins a network with an active profile. Only networks from your profiles are claimed. Without this feature, manual mode remains (open the app, Shortcut, Control Center)."
          }
        }
      }
    },
