          "stringUnit": {
            "state": "translated",
            "value": "Gesendet werden nur das Recipe und die Elementliste der Portalseite, ohne Passwörter, persönliche Werte, Cookies oder Hidden-Felder. Das Ergebnis läuft durch dieselben Prüfungen wie ein lokaler Vorschlag."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the recipe and the page's element list are sent, without passwords, personal values, cookies or hidden fields. The result goes through the same checks as a local proposal."
